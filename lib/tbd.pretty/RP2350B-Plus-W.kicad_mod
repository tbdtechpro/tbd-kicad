(footprint "RP2350B-Plus-W" (version 20241229) (generator "pcbnew") (generator_version "9.0") (layer "F.Cu")
	(descr "Waveshare RP2350B-Plus-W, through-hole pads for the 40 castellated pins (Pico 2 W pattern: 2.54 mm pitch, rows 17.78 mm apart, pin 1 top-left 1.25 mm below the top edge, USB-C at the top) plus 15 SMD pads on the back for GP24-35 and GP43-45 (pins 41-55, 1.5 mm square on a 2.54 mm grid centred on the board, rows about 0.5 mm below pins 24/23/22: read from photos, +/-0.3 mm). Board 21 x 51 mm; the radio module hangs 5.7 mm past the bottom edge.")
